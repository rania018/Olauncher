<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower. See https://developer.android.com/guide/topics/data/autobackup
   Calm Launcher: our database and settings never leave the device (spec FR-003, research R11).
   Upstream's own preferences keep their previous behaviour.
-->
<full-backup-content>
    <exclude domain="database" path="calm.db" />
    <exclude domain="database" path="calm.db-shm" />
    <exclude domain="database" path="calm.db-wal" />
    <exclude domain="database" path="calm.db-journal" />
    <exclude domain="file" path="datastore/calm_settings.preferences_pb" />
</full-backup-content>
