<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="40dp">

    <TextView
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/calm_screen_time_limits" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/calm_settings_hint" />

    <TextView
        android:id="@+id/calmPermissions"
        style="@style/CalmButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:layout_marginTop="8dp"
        android:text="@string/calm_settings_permissions" />

    <TextView
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/calm_settings_defaults" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/calm_settings_presets" />

    <EditText
        android:id="@+id/calmPresets"
        style="@style/CalmField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="2, 5, 10, 15"
        android:importantForAutofill="no"
        android:inputType="text"
        android:textStyle="bold" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/calm_settings_cooldown" />

    <EditText
        android:id="@+id/calmCooldown"
        style="@style/CalmField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="2"
        android:textStyle="bold" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/calm_settings_warning" />

    <EditText
        android:id="@+id/calmWarning"
        style="@style/CalmField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="3"
        android:textStyle="bold" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/calm_settings_extension_wait" />

    <EditText
        android:id="@+id/calmExtensionWait"
        style="@style/CalmField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="3"
        android:textStyle="bold" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.8"
        android:text="@string/calm_settings_apply_note" />

    <TextView
        android:id="@+id/calmSettingsError"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/calmSave"
        style="@style/CalmButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:text="@string/calm_settings_save" />

    <TextView
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/calm_settings_apps" />

    <EditText
        android:id="@+id/calmSearch"
        style="@style/CalmField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/calm_settings_search"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions" />
</LinearLayout>
