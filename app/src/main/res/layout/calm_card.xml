<?xml version="1.0" encoding="utf-8"?>
<!-- Calm Launcher time's-up card, drawn as a full-screen opaque overlay (contracts/ui-surfaces.md) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryInverseColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="64dp">

        <TextView
            android:id="@+id/calmCardTitle"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calm_card_title" />

        <TextView
            android:id="@+id/calmCardSubtitle"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="5 min in Instagram" />

        <TextView
            android:id="@+id/calmCardHome"
            style="@style/CalmButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="48dp"
            android:text="@string/calm_go_home" />

        <TextView
            android:id="@+id/calmCardExtend"
            style="@style/CalmButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="16dp"
            android:text="@string/calm_card_extend" />

        <LinearLayout
            android:id="@+id/calmCardExtendRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/calmCardExtendWait"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Available in 15 s" />

            <LinearLayout
                android:id="@+id/calmCardExtendOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/calmCardOverride"
            style="@style/CalmButton.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="40dp"
            android:text="@string/calm_override" />

        <TextView
            android:id="@+id/calmCardOverrideWait"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="Wait 30 s"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
