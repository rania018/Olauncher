<?xml version="1.0" encoding="utf-8"?>
<!-- One tracked app's own session lengths and cooldown (opened by tapping the app in Screen time limits) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/editorTitle"
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowRadius="0"
        android:textStyle="bold" />

    <TextView
        style="@style/CalmBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/calm_settings_presets" />

    <app.calmlauncher.ui.FlowLayout
        android:id="@+id/editorPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <include
        android:id="@+id/editorCooldown"
        layout="@layout/calm_stepper_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />
</LinearLayout>
