<?xml version="1.0" encoding="utf-8"?>
<!-- One app in Screen time limits: icon, name, what applies to it, and Track / Exempt toggles that
     exclude each other (spec FR-004). Tapping a tracked app opens its own settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/calm_row_background"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/calmRowIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/calmRowLabel"
            style="@style/CalmBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Instagram" />

        <TextView
            android:id="@+id/calmRowStatus"
            style="@style/CalmCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:visibility="gone"
            tools:text="2, 5, 10, 15 min · 10 min cooldown"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/calmRowTrack"
        style="@style/CalmToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:text="@string/calm_settings_track_box" />

    <TextView
        android:id="@+id/calmRowExempt"
        style="@style/CalmToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:paddingHorizontal="12dp"
        android:text="@string/calm_settings_exempt_box" />
</LinearLayout>
