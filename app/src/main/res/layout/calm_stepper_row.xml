<?xml version="1.0" encoding="utf-8"?>
<!-- One number setting with minus and plus buttons: "Cooldown after time's up   (−) 10 min (+)" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stepLabel"
            style="@style/CalmBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Cooldown after time's up" />

        <TextView
            android:id="@+id/stepHint"
            style="@style/CalmCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            tools:text="Blocks the app for a while"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/stepMinus"
        style="@style/CalmBody"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/calm_stepper_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/calm_step_minus"
        android:textColor="?attr/calmAccent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stepValue"
        style="@style/CalmBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="76dp"
        android:paddingHorizontal="4dp"
        android:textStyle="bold"
        tools:text="10 min" />

    <TextView
        android:id="@+id/stepPlus"
        style="@style/CalmBody"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/calm_stepper_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/calm_step_plus"
        android:textColor="?attr/calmAccent"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
