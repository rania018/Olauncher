<?xml version="1.0" encoding="utf-8"?>
<!-- A toggle chip (Track / Exempt, Pill / Bar / Off): filled with the accent when selected -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/calm_accent_soft">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="?attr/calmAccent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/calm_line" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
