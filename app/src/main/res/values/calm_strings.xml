    <!-- App limits accessibility service (research R13) -->
    <string name="calm_access_label">Calm Launcher app limits</string>
    <string name="calm_access_summary">Asks “How long?” for tracked apps however they are opened</string>
    <string name="calm_access_description">Lets Calm Launcher see which app comes to the front, so a tracked app opened from the recent-apps list, a link or a notification asks “How long?” first, and a session ends when you leave its app. It only learns the name of the app in front. It never reads what is on screen.</string>

